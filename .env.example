# Safe examples only. Never commit .env.local.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/KROVEX_DATABASE
NEXT_PUBLIC_SITE_URL=https://YOUR_CONTROLLED_DOMAIN

SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=KROVEX <web@YOUR_CONTROLLED_DOMAIN>
SMTP_REPLY_TO=web@YOUR_CONTROLLED_DOMAIN
# Change to the approved final recipient only for the authorized live test.
OWNER_NOTIFICATION_EMAIL=test-recipient@example.com

# scrypt$<32 hex salt>$<128 hex derived key>; see README.
# In dotenv files, escape each dollar sign in the hash with a backslash (see README).
ADMIN_PASSWORD_HASH='REPLACE_WITH_SCRYPT_HASH'
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
