{
  "name": "krovex-trial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"console.error('Local dev server is disabled for this project. Use the Vercel deployment/preview workflow; port 3000 is reserved for Weblore.ai.'); process.exit(1)\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --config=drizzle.krovex.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.krovex.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --conditions=react-server --import=tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.21.0",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "nodemailer": "9.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "playwright-core": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
